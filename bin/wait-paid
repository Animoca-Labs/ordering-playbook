#!/usr/bin/env bash
# wait-paid — wait for a UCP checkout's payment outcome after `ucp-checkout complete`.
# Usage: wait-paid ord_... chk_... [max_seconds]   (default max_seconds = 240)
#
# Three read-only surfaces are checked each poll tick (~5s):
#   1. `ucp-order get`      — the paid receipt (SUCCESS). Payment success DOES
#                             propagate to the order resource (success_info).
#   2. `ucp-checkout get`   — terminal failure STATUSES: failed / canceled /
#                             cancelled / requires_escalation. The CLI's own
#                             workflow FSM expects these; whether the eats365
#                             external bridge sets them is unverified — a
#                             best-effort net, not the primary failure channel.
#   3. `events poll --no-ack` (UNTYPED) — the only channel where a declined /
#                             failed payment actually shows up today:
#                             `agent_order.failed`. An untyped --no-ack poll is
#                             a pure peek — it acknowledges NOTHING. Never use a
#                             TYPED poll here: typed polls ack the other
#                             (skipped) event types, and the event queue is
#                             per-WALLET, shared across conversations — a typed
#                             poll could consume events another conversation is
#                             waiting for. Correlation to THIS checkout is done
#                             client-side via data.metadata.checkoutId (the
#                             external route's shape); the CLI's own
#                             --checkout-id selector cannot be used because its
#                             matcher never reads metadata (see
#                             recordMatchesCheckoutId in the vendored bundle).
#
# One short progress line per tick keeps stdout active (the agent bash tool
# idle-stubs a command after 15s of silence).
#
# max_seconds MUST stay below the sandbox's 300s per-command SDK timeout
# (paramind src/lib/e2b.ts: timeoutMs 300_000). Observed 2026-09-04: MAX=300
# collided with that kill — the SDK rejected the wait at ~301s, the exit code
# became -1, the final marker was lost, and the model hallucinated "paid".
# Hence default 240.
#
# Exit codes: 0 = paid (paid JSON is the last output), 1 = no terminal outcome
# within max_seconds (WAIT_PAID_TIMEOUT), 2 = bad argument, 3 = payment failed
# (WAIT_PAID_FAILED), 4 = the primary order poll itself failed 3 times in a
# row (WAIT_PAID_POLL_ERROR).
set -u
if [ $# -lt 2 ]; then
  echo "usage: wait-paid ord_... chk_... [max_seconds]" >&2
  exit 2
fi
ORDER_ID="$1"
CHECKOUT_ID="$2"
MAX="${3:-240}"
POLL_S="${WAIT_PAID_POLL_SECONDS:-5}"
CLINK="${CLINK_BIN:-/home/user/skills/agentic-payment-skills/bin/clink}"
case "$ORDER_ID" in
  ord_*) ;;
  *) echo "wait-paid: expected an ord_... order id, got: $ORDER_ID" >&2; exit 2 ;;
esac
case "$CHECKOUT_ID" in
  chk_*) ;;
  *) echo "wait-paid: expected a chk_... checkout id, got: $CHECKOUT_ID" >&2; exit 2 ;;
esac
case "$MAX" in
  ''|*[!0-9]*) echo "wait-paid: max_seconds must be a positive integer, got: $MAX" >&2; exit 2 ;;
esac

# Exit 0 + print the status iff stdin JSON has data.status in the CLI's
# terminal-failure vocabulary (ucp-checkout-workflow-fsm CHECKOUT_FAILED set).
checkout_failed_status() {
  node -e '
    let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{
      try{
        const j=JSON.parse(s);
        const st=j&&j.data&&j.data.status;
        if(typeof st==="string"&&["failed","canceled","cancelled","requires_escalation"].includes(st.toLowerCase())){
          process.stdout.write(st);process.exit(0);
        }
        process.exit(1);
      }catch{process.exit(1)}
    });'
}

# Exit 0 + print the matched event iff stdin JSON (an untyped events peek)
# contains agent_order.failed correlated to the checkout id in argv[1] via
# data.metadata.checkoutId (external route shape) or data.checkoutId /
# data.checkout_id (documented shapes).
failed_event_for_checkout() {
  node -e '
    let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{
      try{
        const chk=process.argv[1];
        const j=JSON.parse(s);
        const evs=j&&j.data&&Array.isArray(j.data.events)?j.data.events:[];
        const hit=evs.find(e=>e&&e.eventType==="agent_order.failed"&&e.data&&(
          (e.data.metadata&&e.data.metadata.checkoutId===chk)||
          e.data.checkoutId===chk||e.data.checkout_id===chk));
        if(hit){process.stdout.write(JSON.stringify(hit));process.exit(0)}
        process.exit(1);
      }catch{process.exit(1)}
    });' "$1"
}

deadline=$((SECONDS + MAX))
n=0
poll_errors=0
while [ "$SECONDS" -lt "$deadline" ]; do
  # 1. PRIMARY: order receipt (success surface).
  out="$("$CLINK" ucp-order get --order-id "$ORDER_ID" --format json 2>&1)"
  rc=$?
  if printf '%s' "$out" | grep -Eq '"result":"paid"|"status":"paid"|"detailStatus":"complete(d)?"'; then
    printf '%s\n' "$out"
    printf '%s' "$out" 2>/dev/null > /home/user/.last-paid-order.json || true
    exit 0
  fi
  # Extra net: a terminal failure marker on the order resource itself (never
  # observed in practice, but harmless to keep).
  if printf '%s' "$out" | grep -Eq '"result":"failed"|"status":"failed"|"detailStatus":"failed"|"result":"cancelled"|"status":"cancelled"'; then
    printf '%s\n' "$out"
    echo "WAIT_PAID_FAILED order=$ORDER_ID surface=ucp-order"
    exit 3
  fi
  if [ "$rc" -ne 0 ] || printf '%s' "$out" | grep -Eq '"ok": ?false'; then
    poll_errors=$((poll_errors + 1))
    if [ "$poll_errors" -ge 3 ]; then
      printf '%s\n' "$out"
      echo "WAIT_PAID_POLL_ERROR order=$ORDER_ID"
      exit 4
    fi
  else
    poll_errors=0
  fi

  # 2. BEST-EFFORT: terminal failure status on the checkout session.
  cout="$("$CLINK" ucp-checkout get --checkout-id "$CHECKOUT_ID" --format json 2>&1)"
  if st="$(printf '%s' "$cout" | checkout_failed_status)"; then
    printf '%s\n' "$cout"
    echo "WAIT_PAID_FAILED order=$ORDER_ID checkout=$CHECKOUT_ID status=$st"
    exit 3
  fi

  # 3. BEST-EFFORT: passive peek for this checkout's agent_order.failed event.
  eout="$("$CLINK" events poll --no-ack --format json --max-wait 1 2>&1)"
  if ev="$(printf '%s' "$eout" | failed_event_for_checkout "$CHECKOUT_ID")"; then
    printf '%s\n' "$ev"
    echo "WAIT_PAID_FAILED order=$ORDER_ID checkout=$CHECKOUT_ID event=agent_order.failed"
    exit 3
  fi

  n=$((n + 1))
  echo "wait-paid: poll $n - not paid yet"
  sleep "$POLL_S"
done
echo "WAIT_PAID_TIMEOUT order=$ORDER_ID after ${MAX}s"
exit 1
